# ==========================================
# hw-agent-demo 本地环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，严禁提交。
# ==========================================

# ---------- 1. 模型配置（对接 DeepSeek OpenAI 兼容接口） ----------
MODEL_API_KEY=sk-your-model-api-key
MODEL_NAME=deepseek-v4-flash
MODEL_URL=https://api.deepseek.com

# ---------- 2. Agent 全局配置 ----------
MAX_ITERATIONS=50
AGENT_RUN_PORT=8080

# ---------- 3. AgentArts 区域（Identity 出站凭据使用） ----------
HUAWEICLOUD_SDK_REGION=cn-southwest-2

# 本地联调需要 AK/SK（AgentArts Identity SDK 本地鉴权）；
# 云上运行时由 Gateway 注入 Workload Access Token，无需配置。
HUAWEICLOUD_SDK_AK=your-huaweicloud-ak
HUAWEICLOUD_SDK_SK=your-huaweicloud-sk

# ---------- 4. OutBound：Credential Provider 名称（非机密） ----------
# 与 AgentArts Identity 控制台创建的名称保持一致
GITHUB_PROVIDER_NAME=github-provider
GITHUB_SCOPES=repo,read:user
# 自建 GitHub OAuth 回调时使用（AgentArts Identity 托管授权可留空）：
# GITHUB_OAUTH_CALLBACK_URL=https://your-app.example.com/auth/callback

IAM_USERS_PROVIDER_NAME=iam-users-readonly
IAM_USERS_AGENCY_SESSION_NAME=hw-agent-demo-iam-readonly
IAM_USERS_REGION=cn-southwest-2
# IAM_USERS_ENDPOINT=https://iam.cn-southwest-2.myhuaweicloud.com

M365_EMAIL_PROVIDER_NAME=m365-email-provider
M365_EMAIL_SCOPES=https://graph.microsoft.com/Mail.Read,https://graph.microsoft.com/Mail.ReadWrite,https://graph.microsoft.com/Mail.Send
# 每次发送强制重新授权（默认 false：授权一次后复用 Identity vault token）：
# M365_FORCE_AUTH=false
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0/me

FEISHU_PROVIDER_NAME=feishu-provider
# FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis

# ---------- 5. InBound：Microsoft Entra ID（本地自建登录用） ----------
# 未配置 OAUTH2_CLIENT_ID 时，/auth/login 自动进入开发模式（dev-user）。
# 云上公网形态由 Cloudflare Pages + MSAL 与 Gateway CUSTOM_JWT 接管，
# 不读取这里的值（CUSTOM_JWT 配置见 .agentarts_config.yaml）。
OAUTH2_CLIENT_ID=your-entra-client-id
OAUTH2_CLIENT_SECRET=your-entra-client-secret
# 仅允许固定租户 d72bac4d-feb6-432b-b2be-79502440c674 下的账号登录，
# 与前端 ENTRA.tenant / 网关 CUSTOM_JWT discovery_url 保持一致。
OAUTH2_AUTHORIZE_URL=https://login.microsoftonline.com/d72bac4d-feb6-432b-b2be-79502440c674/oauth2/v2.0/authorize
OAUTH2_TOKEN_URL=https://login.microsoftonline.com/d72bac4d-feb6-432b-b2be-79502440c674/oauth2/v2.0/token
OAUTH2_USERINFO_URL=https://graph.microsoft.com/v1.0/me
OAUTH2_SCOPES=openid profile email User.Read
OAUTH2_CALLBACK_URL=http://localhost:8080/auth/callback
# 会话 JWT 签名密钥（生产环境务必改为随机长字符串）：
# OAUTH2_JWT_SECRET=change-me-to-a-random-long-string
# OAUTH2_SESSION_TTL_SECONDS=7200
